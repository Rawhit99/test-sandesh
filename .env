# =========================
# Images (only thing users pull)
# =========================
SANDESH_BACKEND_IMAGE=ghcr.io/rawhit99/sandesh-email-service-backend:latest
SANDESH_FRONTEND_IMAGE=ghcr.io/rawhit99/sandesh-email-service-frontend:latest


# Keep DATABASE_URL aligned with POSTGRES_* above
DATABASE_URL=postgresql://your_db_user:your_db_password@your-rds-host.region.rds.amazonaws.com/your_database_name

# =========================
# Platform bootstrap
# =========================
PLATFORM_ADMIN_USERNAME=admin@yourcompany.com
PLATFORM_ADMIN_PASSWORD=change-me-strong-password
DEFAULT_ORGANIZATION=Your Organization

# =========================
# Redis (external)
# =========================
REDIS_URL=redis://:your_redis_password@your-redis-host:6379/0
REDIS_EXPOSED_PORT=6379

# =========================
# API / App
# =========================
API_HOST=0.0.0.0
API_PORT=8000
API_EXPOSED_PORT=8000
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# =========================
# Auth
# =========================
JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_KEYS=

# =========================
# Queue worker tuning
# =========================
QUEUE_WORKER_CONCURRENCY=8
QUEUE_POLL_TIMEOUT_SECONDS=3
QUEUE_MAX_RETRIES=5
QUEUE_RETRY_BACKOFF_SECONDS=2

# =========================
# Frontend
# =========================
FRONTEND_EXPOSED_PORT=3000
REACT_APP_API_URL=http://your-server-ip-or-host:8000

# =========================
# CORS
# =========================
CORS_ALLOW_ORIGINS=http://your-server-ip-or-host:3000,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
TRUSTED_HOSTS=*

# =========================
# Compose
# =========================
COMPOSE_PROJECT_NAME=sandesh
